<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="600.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.OrganizationController"
            stylesheets="@/style/style.css">
    <top>
    <MenuBar styleClass="menu-bar">
        <Menu text="File">
            <MenuItem text="Exit" onAction="#handleExit"/>
        </Menu>
        <Menu text="Format">
            <MenuItem text="Font Size"        onAction="#handleFontSize"/>
            <MenuItem text="Font Family"      onAction="#handleFontFamily"/>
            <MenuItem text="Background Color" onAction="#handleThemeToggle"/>
        </Menu>
        <Menu text="Help">
            <MenuItem text="About App" onAction="#handleAbout"/>
        </Menu>
    </MenuBar>
</top>
    <center>
        <VBox spacing="20" style="-fx-padding:30; -fx-background-color:#f8f9fa;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="← Back" onAction="#goBack" styleClass="btn-secondary"/>
                <Label text="Organizations Management"
                       style="-fx-font-size:20; -fx-font-weight:bold; -fx-text-fill:#1e272e;"/>
            </HBox>

            <!-- Form -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <TextField fx:id="nameField"    promptText="Organization Name" prefWidth="200" styleClass="input-field"/>
                <TextField fx:id="typeField"    promptText="Type (NGO, UN...)" prefWidth="180" styleClass="input-field"/>
                <TextField fx:id="contactField" promptText="Contact Info"       prefWidth="200" styleClass="input-field"/>
                <Button text="Add"    onAction="#handleAdd"    styleClass="btn-primary"/>
                <Button text="Update" onAction="#handleUpdate" styleClass="btn-warning"/>
                <Button text="Delete" onAction="#handleDelete" styleClass="btn-danger"/>
                <Button text="Reset"  onAction="#handleReset"  styleClass="btn-secondary"/>
            </HBox>

            <Label fx:id="statusLabel" style="-fx-font-size:13;"/>

            <!-- Table -->
            <TableView fx:id="orgTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"      text="ID"           prefWidth="60"/>
                    <TableColumn fx:id="colName"    text="Name"         prefWidth="220"/>
                    <TableColumn fx:id="colType"    text="Type"         prefWidth="150"/>
                    <TableColumn fx:id="colContact" text="Contact Info" prefWidth="250"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>