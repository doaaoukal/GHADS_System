<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="500.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ProfileController"
            stylesheets="@/style/style.css">
   <top>
    <MenuBar styleClass="menu-bar">
        <Menu text="File">
            <MenuItem text="Exit" onAction="#handleExit"/>
        </Menu>
        <Menu text="Format">
            <MenuItem text="Font Size"        onAction="#handleFontSize"/>
            <MenuItem text="Font Family"      onAction="#handleFontFamily"/>
            <MenuItem text="Background Color" onAction="#handleThemeToggle"/>
        </Menu>
        <Menu text="Help">
            <MenuItem text="About App" onAction="#handleAbout"/>
        </Menu>
    </MenuBar>
</top>
    <center>
        <VBox spacing="25" style="-fx-padding:40; -fx-background-color:#f8f9fa;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="← Back" onAction="#goBack" styleClass="btn-secondary"/>
                <Label text="My Profile"
                       style="-fx-font-size:20; -fx-font-weight:bold; -fx-text-fill:#1e272e;"/>
            </HBox>

            <HBox spacing="40" alignment="CENTER_LEFT">
                <!-- Photo Section -->
                <VBox spacing="10" alignment="CENTER">
                    <ImageView fx:id="photoView" fitWidth="120" fitHeight="120"
                               style="-fx-border-color:#dcdde1; -fx-border-radius:60; -fx-border-width:2;"/>
                    <Button text="Change Photo" onAction="#handleUploadPhoto" styleClass="btn-secondary"/>
                </VBox>

                <!-- Info Section -->
                <VBox spacing="15" VBox.vgrow="ALWAYS">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Full Name:" prefWidth="100" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="fullNameField" prefWidth="250" styleClass="input-field"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Username:" prefWidth="100" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="usernameField" prefWidth="250" styleClass="input-field"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Email:" prefWidth="100" style="-fx-font-weight:bold;"/>
                        <TextField fx:id="emailField" prefWidth="250" styleClass="input-field"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Role:" prefWidth="100" style="-fx-font-weight:bold;"/>
                        <Label fx:id="roleLabel" style="-fx-text-fill:#27ae60; -fx-font-weight:bold;"/>
                    </HBox>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <Button text="Save Changes" onAction="#handleUpdate" styleClass="btn-primary"/>
                <Button text="Reset"        onAction="#handleReset"  styleClass="btn-secondary"/>
            </HBox>

            <Label fx:id="statusLabel" style="-fx-font-size:13;"/>
        </VBox>
    </center>
</BorderPane>