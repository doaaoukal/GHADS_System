<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="400.0" prefWidth="500.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ChangePasswordController"
            stylesheets="@/style/style.css">
   <top>
    <MenuBar styleClass="menu-bar">
        <Menu text="File">
            <MenuItem text="Exit" onAction="#handleExit"/>
        </Menu>
        <Menu text="Format">
            <MenuItem text="Font Size"        onAction="#handleFontSize"/>
            <MenuItem text="Font Family"      onAction="#handleFontFamily"/>
            <MenuItem text="Background Color" onAction="#handleThemeToggle"/>
        </Menu>
        <Menu text="Help">
            <MenuItem text="About App" onAction="#handleAbout"/>
        </Menu>
    </MenuBar>
</top>
    <center>
        <VBox spacing="25" style="-fx-padding:50; -fx-background-color:#f8f9fa;"
              alignment="CENTER_LEFT">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="← Back" onAction="#goBack" styleClass="btn-secondary"/>
                <Label text="Change Password"
                       style="-fx-font-size:20; -fx-font-weight:bold; -fx-text-fill:#1e272e;"/>
            </HBox>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Current Password:" prefWidth="150" style="-fx-font-weight:bold;"/>
                <PasswordField fx:id="currentPasswordField" prefWidth="250" styleClass="input-field"/>
            </HBox>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="New Password:" prefWidth="150" style="-fx-font-weight:bold;"/>
                <PasswordField fx:id="newPasswordField" prefWidth="250" styleClass="input-field"/>
            </HBox>
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Confirm Password:" prefWidth="150" style="-fx-font-weight:bold;"/>
                <PasswordField fx:id="confirmPasswordField" prefWidth="250" styleClass="input-field"/>
            </HBox>

            <HBox spacing="10">
                <Button text="Change Password" onAction="#handleChangePassword" styleClass="btn-primary"/>
                <Button text="Reset"           onAction="#handleReset"           styleClass="btn-secondary"/>
            </HBox>

            <Label fx:id="statusLabel" style="-fx-font-size:13;"/>
        </VBox>
    </center>
</BorderPane>