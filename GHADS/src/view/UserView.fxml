
<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="650.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.UserController"
            stylesheets="@/style/style.css">
    <top>
        <MenuBar styleClass="menu-bar">
            <Menu text="File"><MenuItem text="Exit" onAction="#handleExit"/></Menu>
            <Menu text="Format">
                <MenuItem text="Font Size" onAction="#handleFontSize"/>
                <MenuItem text="Font Family" onAction="#handleFontFamily"/>
                <MenuItem text="Background Color" onAction="#handleThemeToggle"/>
            </Menu>
            <Menu text="Help"><MenuItem text="About App" onAction="#handleAbout"/></Menu>
        </MenuBar>
    </top>
    <center>
        <VBox spacing="20" style="-fx-padding:30; -fx-background-color:#f8f9fa;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button text="← Back" onAction="#goBack" styleClass="btn-secondary"/>
                <Label text="Users Management"
                       style="-fx-font-size:20; -fx-font-weight:bold; -fx-text-fill:#1e272e;"/>
            </HBox>

            <!-- Form -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <VBox spacing="5" alignment="CENTER">
                    <ImageView fx:id="photoView" fitWidth="70" fitHeight="70"
                               style="-fx-border-color:#dcdde1; -fx-border-radius:35;"/>
                    <Button text="Upload Photo" onAction="#handleUploadPhoto"
                            styleClass="btn-secondary" style="-fx-font-size:10;"/>
                </VBox>
                <VBox spacing="8">
                    <HBox spacing="10">
                        <TextField fx:id="fullNameField"  promptText="Full Name"  prefWidth="180" styleClass="input-field"/>
                        <TextField fx:id="usernameField"  promptText="Username"   prefWidth="150" styleClass="input-field"/>
                        <PasswordField fx:id="passwordField" promptText="Password" prefWidth="150" styleClass="input-field"/>
                    </HBox>
                    <HBox spacing="10">
                        <TextField fx:id="emailField" promptText="Email" prefWidth="200" styleClass="input-field"/>
                        <ComboBox fx:id="roleCombo"   promptText="Role"  prefWidth="140"/>
                        <ComboBox fx:id="orgCombo"    promptText="Organization" prefWidth="180"/>
                    </HBox>
                </VBox>
            </HBox>

            <HBox spacing="10">
                <Button text="Add"    onAction="#handleAdd"    styleClass="btn-primary"/>
                <Button text="Update" onAction="#handleUpdate" styleClass="btn-warning"/>
                <Button text="Delete" onAction="#handleDelete" styleClass="btn-danger"/>
                <Button text="Reset"  onAction="#handleReset"  styleClass="btn-secondary"/>
            </HBox>

            <Label fx:id="statusLabel" style="-fx-font-size:13;"/>

            <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId"       text="ID"           prefWidth="50"/>
                    <TableColumn fx:id="colName"     text="Full Name"    prefWidth="180"/>
                    <TableColumn fx:id="colUsername" text="Username"     prefWidth="130"/>
                    <TableColumn fx:id="colEmail"    text="Email"        prefWidth="200"/>
                    <TableColumn fx:id="colRole"     text="Role"         prefWidth="120"/>
                    <TableColumn fx:id="colOrg"      text="Organization" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>